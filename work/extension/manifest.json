{
  "manifest_version": 3,
  "name": "iPhoneduo助手aigoodbro",
  "homepage_url": "https://aigoodbro.com",
  "description": "Java 后台监控库存，Chrome 提供实验性 iPhone 结账辅助；实站自动下单尚未验收。",
  "version": "1.3.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 iPhoneduo助手aigoodbro"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "1016v6",
  "key": "",
  "content_scripts": [
    {
      "matches": ["https://www.apple.com.cn/shop/buy-iphone/*", "https://www.apple.com.cn/shop/buy-watch/*", "https://www.apple.com.cn/shop/product/*"],
      "js": ["inventory-page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.apple.com.cn/shop/buy-iphone/*", "https://www.apple.com.cn/shop/buy-watch/*", "https://www.apple.com.cn/shop/product/*"],
      "js": ["inventory-content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.apple.com.cn/shop/*",
        "https://secure6.www.apple.com.cn/shop/*"
      ],
      "js": [
        "checkout-dom.js",
        "checkout-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
